  .stat-label {{ font-size:0.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:1px; }}
  .tab-nav {{ display:flex;justify-content:center;gap:16px;margin-bottom:32px; }}
  .tab-btn {{ background:var(--surface);border:2px solid var(--border);color:var(--muted);padding:12px 32px;border-radius:24px;cursor:pointer;font-size:1rem;font-weight:600;transition:all 0.3s; }}
  .tab-btn:hover {{ border-color:var(--accent);color:var(--text); }}
  .tab-btn.int.active {{ border-color:var(--accent);background:linear-gradient(135deg,rgba(0,229,160,0.2),rgba(124,77,255,0.2));color:var(--accent); }}
  .tab-btn.cn.active {{ border-color:var(--accent-red);background:rgba(255,107,107,0.2);color:var(--accent-red); }}
  .tab-btn.model.active {{ border-color:var(--accent);background:linear-gradient(135deg,rgba(0,229,160,0.2),rgba(124,77,255,0.2));color:var(--accent); }}
  .tab-btn.price.active {{ border-color:var(--accent-red);background:rgba(255,107,107,0.2);color:var(--accent-red); }}
  .grid {{ display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px;max-width:1400px;margin:0 auto; }}
  .card {{ background:var(--surface);border:1px solid var(--border);border-radius:var(--card-radius);padding:20px;transition:border-color 0.2s,transform 0.2s;position:relative;overflow:hidden; }}
  .card::before {{ content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--accent),var(--accent2));opacity:0;transition:opacity 0.2s; }}
  .card:hover {{ border-color:#3a3a3a;transform:translateY(-2px); }}
  .card:hover::before {{ opacity:1; }}
  .card[data-heat="5"]::before {{ opacity:1; }}
  .card[data-heat="4"]::before {{ opacity:0.8; }}
  .card-head {{ display:flex;justify-content:space-between;align-items:center;margin-bottom:12px; }}
  .heat-badge {{ font-size:0.85rem;letter-spacing:1px; }}
  .card-date {{ font-size:0.75rem;color:var(--muted); }}
  .card-title {{ font-size:1.05rem;font-weight:600;margin-bottom:8px;color:#fff; }}
  .card-summary {{ font-size:0.88rem;color:var(--muted);margin-bottom:12px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden; }}
  .card-body {{ font-size:0.85rem;color:#bbb;margin-bottom:12px;white-space:pre-wrap; }}
  .card-body summary {{ cursor:pointer;color:var(--accent);font-size:0.8rem;user-select:none; }}
  .card-sources {{ display:flex;flex-wrap:wrap;gap:6px; }}
  .source-tag {{ font-size:0.65rem;padding:2px 8px;border-radius:10px; }}
  .source-tag.source-cn {{ background:rgba(255,107,107,0.1);border:1px solid rgba(255,107,107,0.3);color:#ff6b6b; }}
  .empty {{ text-align:center;padding:60px;color:var(--muted); }}
  footer {{ text-align:center;padding:40px 20px;color:var(--muted);font-size:0.75rem; }}
  .section-title {{ font-size:1.2rem;color:var(--muted);margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border); }}
  .section-title.int {{ color:var(--accent);border-color:rgba(0,229,160,0.3); }}
  .section-title.cn {{ color:var(--accent-red);border-color:rgba(255,107,107,0.3); }}
  .section-title.model {{ color:var(--accent);border-color:rgba(0,229,160,0.3); }}
  .section-title.price {{ color:var(--accent-red);border-color:rgba(255,107,107,0.3); }}
  @media (max-width:480px) {{ .grid {{ grid-template-columns:1fr; }} .tab-nav {{ flex-direction:column;align-items:center; }} }}
</style>
</head>
<body>
<div class="header">
  <h1>AI 情报日报</h1>
  <div class="meta">每小时自动检索 &middot; 按热度排序 &middot; 国际/国内分别保留最多{MAX_ENTRIES}条 &middot; 保留最近{MAX_DAYS}天</div>
  <div class="stats">
    <div class="stat-item"><div class="stat-num">{len(entries_int)}</div><div class="stat-label">国际情报</div></div>
    <div class="stat-item"><div class="stat-num" style="color:var(--accent-red)">{len(entries_cn)}</div><div class="stat-label">国内情报</div></div>
    <div class="stat-item"><div class="stat-num" id="last-updated">{now_str}</div><div class="stat-label">最后更新</div></div>
  </div>
</div>

<div class="tab-nav">
  <button class="tab-btn int active" onclick="switchTab('int')">🌍 国际情报 ({len(entries_int)})</button>
  <button class="tab-btn cn" onclick="switchTab('cn')">🇨🇳 国内情报 ({len(entries_cn)})</button>
  <button class="tab-btn model" onclick="switchTab('model')">🤖 模型家族特性对比</button>
  <button class="tab-btn price" onclick="switchTab('price')">💰 免费收费对比</button>
</div>

<div id="grid-int" class="tab-content">
  <h2 class="section-title int">国际情报</h2>
  <div class="grid">{int_cards}</div>
</div>

<div id="grid-cn" class="tab-content" style="display:none">
  <h2 class="section-title cn">国内情报</h2>
  <div class="grid">{cn_cards}</div>
</div>
<div id="grid-model" class="tab-content" style="display:none">
  <h2 class="section-title model">模型家族产品特性对比</h2>
  <div class="grid">{model_cards}</div>
</div>
<div id="grid-price" class="tab-content" style="display:none">
  <h2 class="section-title price">免费收费角度对比</h2>
  <div class="grid">{price_cards}</div>
</div>

<footer>AI Daily Intel &middot; 数据每小时自动更新 &middot; 国际/国内分别保留最多{MAX_ENTRIES}条</footer>
<script>{js_code}</script>
</body>
</html>"""
    return html

def _esc(s):
    return (s or "").replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace('"', "&quot;")

# ── main ─────────────────────────────────────────────────────────
if __name__ == "__main__":
    cache = load_cache()
    now = datetime.now()
    print(f"[AI Intel] Loaded: 国际{len(cache.get('entries_int', []))}条 | 国内{len(cache.get('entries_cn', []))}条")
    
    last_update = cache['meta'].get('updated')
    need_refresh = False
    if not last_update:
        need_refresh = True
    else:
        last_dt = datetime.fromisoformat(last_update.replace("Z", "+00:00"))
        hours_diff = (now - last_dt).total_seconds() / 3600
        if hours_diff >= 1:
            need_refresh = True
    
    new_int, new_cn = [], []
    
    if need_refresh:
        print("[AI Intel] Fetching latest AI news from multiple sources...")
        
        # ── 国际数据源 ──
        hn_items = fetch_from_hackernews()
        print(f"[AI Intel] Found {len(hn_items)} AI stories from HN")
        for item in hn_items:
            title = item.get('title', '')
            if not title: continue
            if not already_exists(cache.get("entries_int", []), title):
                heat = min(5, max(2, item.get('points', 0) // 50))
                entry = {"title": title, "summary": f"HN热门话题，{item.get('points', 0)}赞", "body": f"来自Hacker News的热议话题。该讨论有{item.get('points', 0)}个赞。", "sources": [item.get('source', 'Hacker News')], "heat": heat, "timestamp": now.isoformat(), "date": now.strftime("%Y-%m-%d")}
                cache.setdefault("entries_int", []).insert(0, entry)
                new_int.append(title)
            else:
                bump_heat(cache["entries_int"], title, item.get('source', 'Hacker News'))
        
        google_items = fetch_from_google_news()
        print(f"[AI Intel] Found {len(google_items)} news items from Google News")
        for item in google_items:
            title = item.get('title', '')
            if not title: continue
            if not already_exists(cache.get("entries_int", []), title):
                entry = {"title": title, "summary": item.get('desc', '')[:200], "body": title + "\n\n" + (item.get('desc', '') or ''), "sources": [item.get('source', 'Google News')], "heat": 2, "timestamp": now.isoformat(), "date": now.strftime("%Y-%m-%d")}
                cache.setdefault("entries_int", []).insert(0, entry)
                new_int.append(title)
            else:
                bump_heat(cache["entries_int"], title, item.get('source', 'Google News'))
        
        arxiv_items = fetch_from_arxiv()
        print(f"[AI Intel] Found {len(arxiv_items)} papers from arXiv")
        for item in arxiv_items:
            title = item.get('title', '')
            if not title: continue
            if not already_exists(cache.get("entries_int", []), title):
                entry = {"title": title, "summary": item.get('desc', '')[:200], "body": title + "\n\n" + (item.get('desc', '') or ''), "sources": [item.get('source', 'arXiv CS.AI')], "heat": 3, "timestamp": now.isoformat(), "date": now.strftime("%Y-%m-%d")}
                cache.setdefault("entries_int", []).insert(0, entry)
                new_int.append(title)
            else:
                bump_heat(cache["entries_int"], title, item.get('source', 'arXiv CS.AI'))
        
        # ── 国内数据源 ──
        geeker_items = fetch_from_geeker()
        print(f"[AI Intel] Found {len(geeker_items)} news items from GeekerHub")
        for item in geeker_items:
            title = item.get('title', '')
            if not title: continue
            if not already_exists(cache.get("entries_cn", []), title):
                entry = {"title": title, "summary": item.get('desc', '')[:200], "body": title + "\n\n" + (item.get('desc', '') or ''), "sources": [item.get('source', 'GeekerHub')], "heat": 2, "timestamp": now.isoformat(), "date": now.strftime("%Y-%m-%d")}
                cache.setdefault("entries_cn", []).insert(0, entry)
                new_cn.append(title)
            else:
                bump_heat(cache["entries_cn"], title, item.get('source', 'GeekerHub'))
        
        huxiu_items = fetch_from_huxiu()
        print(f"[AI Intel] Found {len(huxiu_items)} news items from Huxiu")
        for item in huxiu_items:
            title = item.get('title', '')
            if not title: continue
            if not already_exists(cache.get("entries_cn", []), title):
                entry = {"title": title, "summary": item.get('desc', '')[:200], "body": title + "\n\n" + (item.get('desc', '') or ''), "sources": [item.get('source', '虎嗅')], "heat": 2, "timestamp": now.isoformat(), "date": now.strftime("%Y-%m-%d")}
                cache.setdefault("entries_cn", []).insert(0, entry)
                new_cn.append(title)
            else:
                bump_heat(cache["entries_cn"], title, item.get('source', '虎嗅'))
        
        _36kr_items = fetch_from_36kr()
        print(f"[AI Intel] Found {len(_36kr_items)} news items from 36Kr")
        for item in _36kr_items:
            title = item.get('title', '')
            if not title: continue
            if not already_exists(cache.get("entries_cn", []), title):
                entry = {"title": title, "summary": item.get('desc', '')[:200], "body": title + "\n\n" + (item.get('desc', '') or ''), "sources": [item.get('source', '36氪')], "heat": 2, "timestamp": now.isoformat(), "date": now.strftime("%Y-%m-%d")}
                cache.setdefault("entries_cn", []).insert(0, entry)
                new_cn.append(title)
            else:
                bump_heat(cache["entries_cn"], title, item.get('source', '36氪'))
        
        ithome_items = fetch_from_ithome()
        print(f"[AI Intel] Found {len(ithome_items)} news items from IT之家")
        for item in ithome_items:
            title = item.get('title', '')
            if not title: continue
            if not already_exists(cache.get("entries_cn", []), title):
                entry = {"title": title, "summary": item.get('desc', '')[:200], "body": title + "\n\n" + (item.get('desc', '') or ''), "sources": [item.get('source', 'IT之家')], "heat": 2, "timestamp": now.isoformat(), "date": now.strftime("%Y-%m-%d")}
                cache.setdefault("entries_cn", []).insert(0, entry)
                new_cn.append(title)
            else:
                bump_heat(cache["entries_cn"], title, item.get('source', 'IT之家'))

        leifeng_items = fetch_from_leifeng()
        print(f"[AI Intel] Found {len(leifeng_items)} news items from 雷锋网")
        for item in leifeng_items:
            title = item.get('title', '')
            if not title: continue
            if not already_exists(cache.get("entries_cn", []), title):
                entry = {"title": title, "summary": item.get('desc', '')[:200], "body": title + "\n\n" + (item.get('desc', '') or ''), "sources": [item.get('source', '雷锋网')], "heat": 2, "timestamp": now.isoformat(), "date": now.strftime("%Y-%m-%d")}
                cache.setdefault("entries_cn", []).insert(0, entry)
                new_cn.append(title)
            else:
                bump_heat(cache["entries_cn"], title, item.get('source', '雷锋网'))

        infoq_items = fetch_from_infoq()
        print(f"[AI Intel] Found {len(infoq_items)} news items from InfoQ")
        for item in infoq_items:
            title = item.get('title', '')
            if not title: continue
            if not already_exists(cache.get("entries_cn", []), title):
                entry = {"title": title, "summary": item.get('desc', '')[:200], "body": title + "\n\n" + (item.get('desc', '') or ''), "sources": [item.get('source', 'InfoQ')], "heat": 2, "timestamp": now.isoformat(), "date": now.strftime("%Y-%m-%d")}
                cache.setdefault("entries_cn", []).insert(0, entry)
                new_cn.append(title)
            else:
                bump_heat(cache["entries_cn"], title, item.get('source', 'InfoQ'))
    
    cache["entries_int"] = clean_and_trim(cache.get("entries_int", []), now)[0]
    cache["entries_cn"] = clean_and_trim(cache.get("entries_cn", []), now)[0]
    cache["entries_int"] = sort_entries(cache["entries_int"])
    cache["entries_cn"] = sort_entries(cache["entries_cn"])
    cache["meta"]["updated"] = now.isoformat()
    save_cache(cache)
    
    html = render_html(cache)
    HTML_FILE.write_text(html, encoding="utf-8")
    
    print(f"[AI Intel] 国际: {len(cache['entries_int'])}条 | 国内: {len(cache['entries_cn'])}条")
    print(f"[AI Intel] Updated: {cache['meta']['updated']}")
    print(f"[AI Intel] HTML written to {HTML_FILE}")
    if new_int:
        print(f"[AI Intel] 国际新增 {len(new_int)} 条")
    if new_cn:
        print(f"[AI Intel] 国内新增 {len(new_cn)} 条")
    if not new_int and not new_cn:
        print("[AI Intel] 无新情报（网络可能不可用）")
