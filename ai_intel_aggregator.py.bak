    def render_cards(entries, is_cn=False):
        cards = []
        for e in entries:
            heat = e.get("heat", 0)
            stars = "★" * min(heat, 5) + "☆" * max(0, 5 - heat)
            sources_list = e.get("sources", [])
            tag_style = "color:#ff6b6b;background:rgba(255,107,107,0.1);border-color:rgba(255,107,107,0.3);" if is_cn else "color:#00e5a0;background:rgba(0,229,160,0.1);border-color:rgba(0,229,160,0.3);"
            sources_html = "".join(f'<span class="source-tag" style="{tag_style}">{_esc(s)}</span>' for s in sources_list)
            date_str = e.get("timestamp", e.get("date", ""))
            excerpt = (e.get("excerpt", "") or e.get("summary", "") or "")[:200]
            cards.append(f"""
            <div class="card" data-heat="{heat}">
                <div class="card-head"><span class="heat-badge">{stars}</span><span class="card-date">{date_str[:16]}</span></div>
                <h2 class="card-title">{_esc(e.get("title", ""))}</h2>
                <p class="card-summary">{_esc(excerpt)}</p>
                <details class="card-body"><summary>展开正文</summary><div class="card-full">{_esc(e.get("body", ""))}</div></details>
                <div class="card-sources">{sources_html}</div>
            </div>""")
        return "\n".join(cards) if cards else '<div class="empty">暂无情报数据</div>'
    
