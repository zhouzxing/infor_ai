  :root {{ --bg:#0d0d0d;--surface:#1a1a1a;--border:#2a2a2a;--accent:#00e5a0;--accent2:#7c4dff;--accent-red:#ff6b6b;--text:#e8e8e8;--muted:#888;--card-radius:12px; }}
